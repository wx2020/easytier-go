#!/bin/sh /etc/rc.common
# procd service for the EasyTier core.
#
# Two modes:
#   local   - easytier-go reads /root/config/easytier/config.toml
#   managed - the official easytier-core runs with -w and pulls its
#             configuration from the EasyTier web console. The local TOML is
#             ignored and the LuCI form is locked (see managed.json).
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/easytier-core
WRAP=/usr/bin/easytier-cgroup-exec
CONF=/root/config/easytier/config.toml
RPC=127.0.0.1:15888
MANAGED=/root/config/easytier/managed.json
OFFICIAL=/root/software/easytier-official/easytier-core

CGROUP=/sys/fs/cgroup/easytier
MARK=0x2345
MARK_RULE=8998
MARK_TABLE=easytiermark

# cfst-style isolation: put the core in its own cgroup v2, mark its sockets
# with nftables and send marked traffic to the main table. Without this the
# sing-box rules (table 2022, preference 9001) can capture the overlay and
# make peer RTT collapse to a local loopback value.
ensure_mark_routing() {
	mkdir -p "$CGROUP" 2>/dev/null || true
	if ! nft list table ip "$MARK_TABLE" >/dev/null 2>&1; then
		nft add table ip "$MARK_TABLE" 2>/dev/null || true
		nft add chain ip "$MARK_TABLE" out '{ type route hook output priority mangle; }' 2>/dev/null || true
		nft add rule ip "$MARK_TABLE" out socket cgroupv2 level 1 "easytier" meta mark set "$MARK" 2>/dev/null || true
	fi
	ip rule show 2>/dev/null | grep -q "fwmark $MARK lookup main" || \
		ip rule add fwmark "$MARK" table main priority "$MARK_RULE" 2>/dev/null || true
}

managed_enabled() {
	[ -f "$MANAGED" ] || return 1
	[ "$(jq -r '.enabled // false' "$MANAGED" 2>/dev/null)" = "true" ]
}

managed_field() {
	jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$MANAGED" 2>/dev/null
}

start_service() {
	# Coexistence with TUN-based policy routing (sing-box uses table 2022).
	# Keep the EasyTier overlay in the main table so it does not get captured
	# by another TUN's default route.
	ip rule add to 10.64.0.0/24 lookup main priority 8990 2>/dev/null || true
	ensure_mark_routing

	if managed_enabled; then
		[ -x "$OFFICIAL" ] || { echo "managed mode: official easytier-core missing"; return 1; }
		url=$(managed_field url "udp://easytier.wx2020.cn:22020/wx2020")
		mid=$(managed_field machine_id "f50")
		host=$(managed_field hostname "f50")
		procd_open_instance
		procd_set_param command "$WRAP" "$OFFICIAL" -w "$url" --machine-id "$mid" --hostname "$host" --rpc-portal "$RPC"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param file "$MANAGED"
		procd_close_instance
		return 0
	fi

	[ -x "$PROG" ] || { echo "easytier-core not installed"; return 1; }
	[ -f "$CONF" ] || { echo "missing $CONF"; return 1; }

	procd_open_instance
	procd_set_param command "$WRAP" "$PROG" --config-file "$CONF" --rpc-portal "$RPC"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}

stop_service() {
	ip rule del to 10.64.0.0/24 lookup main priority 8990 2>/dev/null || true
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "easytier"
}
